+.candle-color-btn {
+  padding: 0;
+}
+
+.candle-color-swatch {
+  width: 16px;
+  height: 16px;
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  overflow: hidden;
+  border-radius: 3px;
+  border: 1px solid rgba(0, 0, 0, 0.12);
+}
+
+.candle-color-swatch__up,
+.candle-color-swatch__down {
+  display: block;
+}
+
+.candle-color-btn .candle-color-swatch__up {
+  background: #13c2c2;
+}
+
+.candle-color-btn .candle-color-swatch__down {
+  background: #fa541c;
+}
+
+.candle-color-btn.is-red-up .candle-color-swatch__up {
+  background: #f5222d;
+}
+
+.candle-color-btn.is-red-up .candle-color-swatch__down {
+  background: #13c2c2;
+}
+
+.chart-left.theme-dark .candle-color-swatch {
+  border-color: rgba(255, 255, 255, 0.18);
+}
+
+.chart-left.theme-dark .candle-color-btn .candle-color-swatch__up {
+  background: #0ecb81;
+}
+
+.chart-left.theme-dark .candle-color-btn .candle-color-swatch__down {
+  background: #f6465d;
+}
+
+.chart-left.theme-dark .candle-color-btn.is-red-up .candle-color-swatch__up {
+  background: #f6465d;
+}
+
+.chart-left.theme-dark .candle-color-btn.is-red-up .candle-color-swatch__down {
+  background: #0ecb81;
+}
+
