+  Forex: { en: 'Forex', zh: '外汇' },
+  Futures: { en: 'Futures', zh: '期货' },
+  MOEX: { en: 'MOEX', zh: 'MOEX' },
+  CNFutures: { en: 'China Futures', zh: '国内期货' },
+  CNFuturesOptions: { en: 'China Futures Options', zh: '国内期货期权' },
+  CNIndexFutures: { en: 'CFFEX Index Futures', zh: '股指期货' },
+  CNIndexOptions: { en: 'CFFEX Index Options', zh: '股指期权' }
+}
+
+/**
+ * Resolve a human market label without leaking raw i18n keys like
+ * `dashboard.indicator.market.CNFutures` when a locale entry is missing.
+ *
+ * @param {(key: string) => string} t - vue-i18n `$t` (or compatible)
+ * @param {string} market
+ * @param {{ locale?: string, fallbackLabel?: string }} [opts]
+ */
+export function resolveMarketLabel (t, market, opts = {}) {
+  const code = String(market || '').trim()
+  if (!code) return ''
+  const translate = typeof t === 'function' ? t : null
+  const keys = [
+    `dashboard.indicator.market.${code}`,
+    `dashboard.analysis.market.${code}`
+  ]
+  if (translate) {
+    for (const key of keys) {
+      const translated = translate(key)
+      if (translated && translated !== key && !String(translated).startsWith('dashboard.')) {
+        return translated
+      }
+    }
+  }
+  if (opts.fallbackLabel) return String(opts.fallbackLabel)
+  const pack = MARKET_LABEL_FALLBACKS[code]
+  if (pack) {
+    const locale = String(opts.locale || '').toLowerCase()
+    if (locale.startsWith('zh')) return pack.zh
+    return pack.en
+  }
+  return code
+}
