+export const MARKET_LABEL_FALLBACKS = {
+  Crypto: { en: 'Crypto', zh: '加密货币' },
+  USStock: { en: 'US Stock', zh: '美股' },
+  CNStock: { en: 'A-Shares', zh: 'A股' },
