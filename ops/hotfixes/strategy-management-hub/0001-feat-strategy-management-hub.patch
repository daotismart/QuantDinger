diff --git a/src/views/backtest-ranking/index.vue b/src/views/backtest-ranking/index.vue
new file mode 100644
index 0000000..6a1b292
--- /dev/null
+++ b/src/views/backtest-ranking/index.vue
@@ -0,0 +1,265 @@
+<template>
+  <div class="backtest-ranking" :class="{ 'theme-dark': isDarkTheme }" data-testid="backtest-ranking">
+    <header class="br-header">
+      <div>
+        <div class="br-kicker">{{ $t('backtestRanking.kicker') }}</div>
+        <h1>{{ $t('backtestRanking.title') }}</h1>
+        <p>{{ $t('backtestRanking.subtitle') }}</p>
+      </div>
+      <div class="br-actions">
+        <a-button icon="apartment" @click="$router.push('/strategy-manage')">
+          {{ $t('backtestRanking.backToManage') }}
+        </a-button>
+        <a-button type="primary" icon="reload" :loading="loading" @click="loadRanking">
+          {{ $t('common.refresh') }}
+        </a-button>
+      </div>
+    </header>
+
+    <section class="br-filters">
+      <a-input
+        v-model="filters.tag"
+        allow-clear
+        :placeholder="$t('backtestRanking.filterTag')"
+        style="width: 200px"
+        @pressEnter="loadRanking"
+      />
+      <a-input
+        v-model="filters.market"
+        allow-clear
+        :placeholder="$t('backtestRanking.filterMarket')"
+        style="width: 160px"
+        @pressEnter="loadRanking"
+      />
+      <a-input
+        v-model="filters.timeframe"
+        allow-clear
+        :placeholder="$t('backtestRanking.filterTimeframe')"
+        style="width: 140px"
+        @pressEnter="loadRanking"
+      />
+      <a-button type="primary" @click="loadRanking">{{ $t('backtestRanking.applyFilters') }}</a-button>
+    </section>
+
+    <a-alert
+      type="info"
+      show-icon
+      class="br-hint"
+      :message="$t('backtestRanking.scoreHint')"
+    />
+
+    <a-table
+      row-key="rowKey"
+      :loading="loading"
+      :columns="columns"
+      :data-source="rows"
+      :pagination="{ pageSize: 20, showSizeChanger: true }"
+      :locale="{ emptyText: $t('backtestRanking.empty') }"
+    >
+      <template slot="rank" slot-scope="text">
+        <span class="rank-pill" :class="{ 'rank-top': text <= 3 }">{{ text }}</span>
+      </template>
+      <template slot="strategy" slot-scope="text, record">
+        <div class="strategy-cell">
+          <strong>{{ text }}</strong>
+          <span>{{ record.family }} · {{ record.market || '-' }} · {{ record.symbol || '-' }} · {{ record.timeframe || '-' }}</span>
+        </div>
+      </template>
+      <template slot="pct" slot-scope="text">
+        <span :class="Number(text) >= 0 ? 'pos' : 'neg'">{{ formatPct(text) }}</span>
+      </template>
+      <template slot="num" slot-scope="text">
+        {{ formatNum(text) }}
+      </template>
+      <template slot="flag" slot-scope="text">
+        <a-tag :color="flagColor(text)">{{ flagLabel(text) }}</a-tag>
+      </template>
+      <template slot="action" slot-scope="text, record">
+        <a-button type="link" size="small" @click="openBacktest(record)">{{ $t('backtestRanking.openBacktest') }}</a-button>
+        <a-button type="link" size="small" @click="openIde(record)">{{ $t('backtestRanking.openIde') }}</a-button>
+      </template>
+    </a-table>
+  </div>
+</template>
+
+<script>
+import { mapState } from 'vuex'
+import { getStrategyBacktestRanking } from '@/api/strategy'
+
+export default {
+  name: 'BacktestRanking',
+  data () {
+    return {
+      loading: false,
+      rows: [],
+      filters: {
+        tag: '',
+        market: '',
+        timeframe: ''
+      }
+    }
+  },
+  computed: {
+    ...mapState({
+      isDarkTheme: state => !!(state.app && state.app.theme === 'dark')
+    }),
+    columns () {
+      return [
+        { title: this.$t('backtestRanking.col.rank'), dataIndex: 'rank', key: 'rank', width: 72, scopedSlots: { customRender: 'rank' } },
+        { title: this.$t('backtestRanking.col.strategy'), dataIndex: 'strategy_name', key: 'strategy', scopedSlots: { customRender: 'strategy' } },
+        { title: this.$t('backtestRanking.col.score'), dataIndex: 'score', key: 'score', width: 100, customRender: (v) => this.formatNum(v) },
+        { title: this.$t('backtestRanking.col.return'), dataIndex: 'total_return', key: 'return', width: 110, scopedSlots: { customRender: 'pct' } },
+        { title: this.$t('backtestRanking.col.sharpe'), dataIndex: 'sharpe', key: 'sharpe', width: 100, scopedSlots: { customRender: 'num' } },
+        { title: this.$t('backtestRanking.col.drawdown'), dataIndex: 'max_drawdown', key: 'dd', width: 110, scopedSlots: { customRender: 'pct' } },
+        { title: this.$t('backtestRanking.col.trades'), dataIndex: 'total_trades', key: 'trades', width: 90 },
+        { title: this.$t('backtestRanking.col.flag'), dataIndex: 'flag', key: 'flag', width: 120, scopedSlots: { customRender: 'flag' } },
+        { title: this.$t('backtestRanking.col.action'), key: 'action', width: 180, scopedSlots: { customRender: 'action' } }
+      ]
+    }
+  },
+  created () {
+    this.loadRanking()
+  },
+  methods: {
+    async loadRanking () {
+      this.loading = true
+      try {
+        const res = await getStrategyBacktestRanking({
+          tag: this.filters.tag || undefined,
+          market: this.filters.market || undefined,
+          timeframe: this.filters.timeframe || undefined,
+          limit: 200
+        })
+        const items = (res && res.code === 1 && res.data && res.data.items) ? res.data.items : []
+        this.rows = items.map((item, index) => ({
+          ...item,
+          rowKey: `${item.run_id || index}-${item.strategy_name}-${item.timeframe}`
+        }))
+      } catch (e) {
+        this.rows = []
+        this.$message.error(e.backendMessage || e.message || this.$t('backtestRanking.loadFailed'))
+      } finally {
+        this.loading = false
+      }
+    },
+    formatPct (value) {
+      const num = Number(value)
+      if (!Number.isFinite(num)) return '-'
+      return `${(num * 100).toFixed(2)}%`
+    },
+    formatNum (value) {
+      const num = Number(value)
+      if (!Number.isFinite(num)) return '-'
+      return num.toFixed(2)
+    },
+    flagColor (flag) {
+      if (flag === 'ok') return 'green'
+      if (flag === 'no_trades') return 'orange'
+      return 'red'
+    },
+    flagLabel (flag) {
+      const key = `backtestRanking.flag.${flag || 'ok'}`
+      const translated = this.$t(key)
+      return translated === key ? flag : translated
+    },
+    openBacktest (record) {
+      const query = {}
+      if (record.source_id) query.sourceId = String(record.source_id)
+      this.$router.push({ path: '/backtest-center', query }).catch(() => {})
+    },
+    openIde (record) {
+      const query = {}
+      if (record.source_id) query.sourceId = String(record.source_id)
+      this.$router.push({ path: '/strategy-ide', query }).catch(() => {})
+    }
+  }
+}
+</script>
+
+<style lang="less" scoped>
+.backtest-ranking {
+  min-height: calc(100vh - 64px);
+  padding: 24px 28px 40px;
+  background: linear-gradient(180deg, #f7f8fa 0%, #eef2f6 100%);
+}
+
+.backtest-ranking.theme-dark {
+  background: linear-gradient(180deg, #0d1117 0%, #161b22 100%);
+  color: #e6edf3;
+}
+
+.br-header {
+  display: flex;
+  justify-content: space-between;
+  gap: 16px;
+  margin-bottom: 16px;
+}
+
+.br-kicker {
+  color: #a16207;
+  font-size: 12px;
+  font-weight: 700;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+}
+
+.br-header h1 {
+  margin: 4px 0 8px;
+  font-size: 28px;
+}
+
+.br-header p {
+  margin: 0;
+  color: #667085;
+  max-width: 680px;
+}
+
+.theme-dark .br-header p { color: #8b949e; }
+
+.br-actions, .br-filters {
+  display: flex;
+  gap: 8px;
+  flex-wrap: wrap;
+  align-items: center;
+}
+
+.br-filters { margin-bottom: 12px; }
+.br-hint { margin-bottom: 14px; }
+
+.rank-pill {
+  display: inline-flex;
+  min-width: 28px;
+  height: 28px;
+  border-radius: 999px;
